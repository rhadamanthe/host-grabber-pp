{
  "name": "host-grabber-pp",
  "version": "0.1.0",
  "description": "The descriptor that allows to run tests for this extension",
  "scripts": {
    "pretest": "npx @puppeteer/browsers install chrome@stable --path ./browsers",
    "test": "karma start",
    "test:debug": "karma start --no-single-run --auto-watch",
    "lint": "eslint . && web-ext lint --ignore-files \"browsers/**/*\" --ignore-files \"coverage/**/*\" --ignore-files \"docs/**/*\"",
    "web-ext": "web-ext run --browser-console",
    "build": "web-ext build --ignore-files browsers tests coverage docs *.js package*.json readme.md"
  },
  "author": "Rhadamanthe",
  "license": "MPL-2.0",
  "homepage": "https://rhadamanthe.github.io/host-grabber-pp",
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.1",
    "@xmldom/xmldom": "^0.9.12",
    "addons-linter": "^10.10.0",
    "eslint": "10.9.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "expect.js": "^0.3.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-mocha": "^2.0.1",
    "karma-mocha-reporter": "^2.2.5",
    "mocha": "^11.8.0",
    "sinon-chrome": "^3.0.1",
    "web-ext": "^10.6.0",
    "webextension-polyfill": "^0.12.0"
  },
  "bugs": {
    "url": "https://github.com/rhadamanthe/host-grabber-pp/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rhadamanthe/host-grabber-pp.git"
  }
}
